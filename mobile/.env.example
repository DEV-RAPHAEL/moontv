# Base URL of the deployed Moon TV web app, without a trailing slash.
# Must be an origin where /api/programmes and /api/schedule return JSON.
# Example: https://moontvonline.com
# Local development: use your computer's LAN IP, not localhost, on a real phone.
# Example: http://192.168.1.10:3000
EXPO_PUBLIC_API_URL=

# Optional embeddable live stream URL (http or https).
# Leave empty to show the Watch Live button as disabled.
EXPO_PUBLIC_STREAM_URL=

# Supabase project (user accounts, favourites, push tokens).
# From Supabase dashboard -> Project Settings -> API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: push notifications (expo-notifications project id, from https://expo.dev/accounts/YOUR_ACCOUNT/settings/notifications).
EXPO_PUBLIC_PROJECT_ID=
