{
  "expo": {
    "name": "Moon TV",
    "slug": "moontv",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "moontv",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 264,
          "resizeMode": "contain",
          "backgroundColor": "#050b07"
        }
      ],
      "expo-notifications",
      "expo-image",
      "expo-font"
    ],
    "android": {
      "package": "com.moontv.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07120C"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moontv.mobile"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "12564296-52e7-47e8-9fd9-47d1f9c5c6cd"
      }
    },
    "owner": "pyraph"
  }
}
