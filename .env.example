# Public site URL used for metadata, sitemap and OpenGraph.
# Optional. Defaults to https://moontvonline.com
NEXT_PUBLIC_SITE_URL=

# Sanity CMS. The project ID is required for content.
# Dataset defaults to production; API version defaults to 2025-01-01.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Resend email. All three are required for the contact, advertising
# and waitlist forms to send. CONTACT_FROM_EMAIL must be on a domain
# verified in Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Live stream embed URL (http/https). Watch buttons are disabled when unset.
NEXT_PUBLIC_STREAM_URL=

# Supabase project (user accounts, favourites, push tokens).
# From Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key for the reminder function. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
